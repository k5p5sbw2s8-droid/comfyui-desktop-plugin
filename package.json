{
  "name": "comfyui-desktop-plugin",
  "version": "0.1.0",
  "description": "Desktop app to generate and run ComfyUI workflows.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "node ./scripts/validate-configs.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "comfyui.desktop.plugin",
    "productName": "ComfyUI Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "configs",
      "docs",
      "README.md"
    ],
    "win": {
      "target": ["nsis"]
    }
  }
}
